# Copy to .env in the project root. Never commit .env.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=180
# Jira Cloud with an unscoped API token and the account email.
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug
# Optional: use issue type ID from Jira connection check.
JIRA_ISSUE_TYPE_ID=
PORT=8000

# Optional fallback if you intentionally use an existing Chromium executable.
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
